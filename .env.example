# Frontend build settings (not secret).
# demo = fictional data in the browser (default). base44 = connected to a Base44 app.
VITE_APP_MODE=demo
VITE_BASE44_APP_ID=
# VITE_BASE44_SERVER_URL=

# Backend secrets are NOT set here. They live in the Base44 secret vault:
#   npx base44 secrets set DENTALLY_BASE_URL=... DENTALLY_USER_AGENT=... DENTALLY_API_TOKEN=... CLINIC_KEY=...
#   Phase 2: SPEECHMATICS_API_KEY=... CONTENT_ENCRYPTION_KEY=...

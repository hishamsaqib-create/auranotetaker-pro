{
  "name": "auranotetaker-pro",
  "private": true,
  "version": "0.1.0",
  "description": "Ambient AI dental scribe and clinical-record audit for Aura Dental Clinic",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.base44.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:shared": "node scripts/sync-base44-shared.mjs",
    "check:shared": "node scripts/sync-base44-shared.mjs --check",
    "roadmap:issues": "node scripts/github/print-roadmap-issues.mjs",
    "build:demo-page": "node scripts/build-demo-artifact.mjs"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.54",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
